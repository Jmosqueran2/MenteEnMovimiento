# Los scripts y la configuración del servidor deben quedar con finales de línea de Linux.
*.sh text eol=lf
deploy/Caddyfile.plantilla text eol=lf
deploy/*.env* text eol=lf

# Archivos binarios: nunca convertir finales de línea (un PDF se dañaría).
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.mp3 binary

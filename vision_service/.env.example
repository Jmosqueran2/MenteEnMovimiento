# Debe ser igual a DJANGO_SECRET_KEY del backend para aceptar sus tokens JWT.
# Vacío = sin autenticación (solo desarrollo).
VISION_JWT_SECRETO=
# Orígenes web que pueden abrir el WebSocket, separados por coma. Vacío = cualquiera.
# En producción: https://tu-dominio (y http://localhost:8001 si se usa la página de prueba).
VISION_ORIGENES=
# YOLO corre 1 de cada N frames (la postura cambia lento).
VISION_POSE_CADA_N=2
VISION_TAMANO_POSE=320
# Página de prueba en "/". Desactivar en producción si no se usa.
VISION_DEMO=true

# Copia este archivo como .env y ajusta los valores.

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ORIGINS=http://localhost:5173
# En producción, el dominio HTTPS, p. ej. https://3-85-12-4.sslip.io
DJANGO_CSRF_TRUSTED_ORIGINS=

# Vacío = SQLite local. En AWS (RDS):
# DATABASE_URL=postgres://mente:CLAVE@mente-db.xxxxx.us-east-1.rds.amazonaws.com:5432/mente
DATABASE_URL=

# Vacío = archivos en backend/media. En AWS, el nombre del bucket S3.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
# Solo para probar S3 desde tu PC con AWS Academy (copiar de "AWS Details" del Learner Lab;
# caducan cuando se apaga el lab). En EC2 NO se ponen: se usa LabInstanceProfile.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

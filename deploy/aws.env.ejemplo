# Copia este archivo como aws.env (en el servidor) y complétalo con lo que
# creaste en la consola de AWS. aws.env no se sube a GitHub.

# S3: nombre exacto del bucket (p. ej. mente-historia-jmosquera).
# En EC2 no hacen falta claves: los permisos vienen del rol LabInstanceProfile.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# RDS: punto de enlace (endpoint) de la base, usuario y contraseña.
# Usa una contraseña solo con letras y números (los símbolos rompen la URL).
# DATABASE_URL=postgres://mente:TuClave123@mente-db.xxxxxxxx.us-east-1.rds.amazonaws.com:5432/mente
DATABASE_URL=

# true = cualquiera puede crear su cuenta de cuidador desde la pantalla de inicio.
# false = las cuentas solo se crean desde /admin.
REGISTRO_ABIERTO=true

# Opcional: déjalo vacío y se usa la IP pública con sslip.io (p. ej. 3-85-12-4.sslip.io).
DOMINIO=
